---
import Layout from '../layouts/Layout.astro';
import EventList from '../components/EventList.tsx';
import { supabase } from '../lib/supabase';
import { bangaloreDayKey } from '../lib/event-date';
import type { Event } from '../lib/types';

const siteUrl = Astro.site!.toString().replace(/\/$/, '');

let upcomingEvents: Event[] = [];
try {
  const todayIso = new Date().toISOString().slice(0, 10);
  const { data } = await supabase
    .from('events')
    .select('*')
    .eq('is_published', true)
    // ends_at, not date: a multi-day event stays listed until its last day.
    .gte('ends_at', todayIso)
    .order('date', { ascending: true });
  upcomingEvents = data ?? [];
} catch {
  upcomingEvents = [];
}

// schema.org wants date-only values for all-day events and a real interval for
// everything else. Without an explicit end we keep the old 4-hour assumption.
function schemaDates(event: Event): { startDate: string; endDate: string } {
  if (event.is_all_day) {
    return {
      startDate: bangaloreDayKey(event.date),
      endDate: bangaloreDayKey(event.end_date || event.date),
    };
  }
  if (event.end_date) {
    return { startDate: event.date, endDate: event.end_date };
  }
  if (event.date.includes('T')) {
    const d = new Date(event.date);
    d.setHours(d.getHours() + 4);
    return { startDate: event.date, endDate: d.toISOString() };
  }
  return { startDate: event.date, endDate: event.date };
}

const organization = {
  '@type': 'Organization',
  name: 'Board Game Company',
  url: siteUrl,
};

const eventSchema = upcomingEvents.map((event) => {
  const registrationUrl = event.externally_managed
    ? (event.external_registration_url || `${siteUrl}/calendar`)
    : `${siteUrl}/register?event=${event.id}`;

  const { startDate, endDate } = schemaDates(event);

  return {
    '@context': 'https://schema.org',
    '@type': 'Event',
    name: event.name,
    description: event.description,
    image: [`${siteUrl}/og-home.jpg`],
    startDate,
    endDate,
    eventStatus: 'https://schema.org/EventScheduled',
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    url: registrationUrl,
    location: {
      '@type': 'Place',
      name: event.venue_name,
      address: {
        '@type': 'PostalAddress',
        addressLocality: event.venue_area || 'Bangalore',
        addressRegion: 'Karnataka',
        addressCountry: 'IN',
      },
    },
    organizer: organization,
    performer: organization,
    ...(!event.externally_managed ? {
      offers: {
        '@type': 'Offer',
        price: event.price,
        priceCurrency: 'INR',
        availability: 'https://schema.org/InStock',
        url: registrationUrl,
        validFrom: event.created_at,
      },
    } : {}),
  };
});
---

<Layout
  title="Calendar"
  description="Upcoming BGC sessions — board game nights, TTRPGs, and tournaments in Bangalore"
  schema={eventSchema.length > 0 ? eventSchema : undefined}
>
  <section class="py-14" style="background: #FFF8E7;">
    <div class="max-w-[1200px] mx-auto px-6 text-center">
      <span class="section-tag">What's Happening</span>
      <h1 class="font-heading font-bold" style="font-size: clamp(2.4rem, 5vw, 3.8rem); letter-spacing: -1px;">
        Upcoming Sessions
      </h1>
      <p class="text-lg text-[#1A1A1A]/70 mt-3">
        Pick a date, bring a friend, and roll some dice.
      </p>
    </div>
  </section>

  <section class="pb-20">
    <div class="max-w-[1200px] mx-auto px-6">
      <EventList client:load initialEvents={upcomingEvents} />
    </div>
  </section>
</Layout>
